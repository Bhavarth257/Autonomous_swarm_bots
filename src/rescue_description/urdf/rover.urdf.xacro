<?xml version="1.0"?>
<!--
  Six-wheel skid-steer search rover: 28 cm wheels (climbs ~10-12 cm steps), 0.88 x 0.55 m,
  14 cm ground clearance so it doesn't hang up on a block between its wheels.

  base_link sits at axle height (body_height 0.14 for the odometry node). The 3D lidar is
  on the front deck (low enough to see the floor from ~0.7 m); the RGB + thermal camera
  head with its headlight is on a rear mast at 0.62 m, looking over the deck and
  slightly down. Gazebo's DiffDrive drives all six wheels from /<ns>/cmd_vel.
-->
<robot name="rover" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ns" default="r1"/>
  <xacro:arg name="sensors" default="true"/>
  <xacro:property name="ns" value="$(arg ns)"/>

  <xacro:property name="wheel_r" value="0.14"/>
  <xacro:property name="wheel_w" value="0.07"/>
  <xacro:property name="track" value="0.48"/>       <!-- wheel centre to wheel centre, across -->
  <xacro:property name="axle_x" value="0.30"/>      <!-- front/rear axles; middle at 0 -->
  <xacro:property name="chassis_l" value="0.70"/>
  <xacro:property name="chassis_w" value="0.34"/>
  <xacro:property name="chassis_h" value="0.14"/>
  <xacro:property name="chassis_z" value="0.07"/>   <!-- centre above the axles: 14 cm clearance -->
  <xacro:property name="mast_x" value="-0.25"/>
  <xacro:property name="head_z" value="0.48"/>      <!-- camera above the axles: 0.62 m above ground -->

  <material name="body"><color rgba="0.95 0.45 0.08 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.13 1"/></material>
  <material name="rubber"><color rgba="0.03 0.03 0.03 1"/></material>
  <material name="metal"><color rgba="0.7 0.7 0.72 1"/></material>
  <material name="eye"><color rgba="0.15 0.35 0.95 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z *origin">
    <inertial><xacro:insert_block name="origin"/><mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ===== chassis ===== -->
  <link name="base_link">
    <visual><origin xyz="0 0 ${chassis_z}"/><geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry><material name="body"/></visual>
    <visual><origin xyz="0 0 ${chassis_z + chassis_h/2 + 0.005}"/><geometry><box size="${chassis_l - 0.06} ${chassis_w - 0.04} 0.01"/></geometry><material name="dark"/></visual>
    <!-- bumpers -->
    <visual><origin xyz="${chassis_l/2 + 0.01} 0 ${chassis_z - 0.02}"/><geometry><box size="0.02 ${chassis_w + 0.02} 0.05"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="${-chassis_l/2 - 0.01} 0 ${chassis_z - 0.02}"/><geometry><box size="0.02 ${chassis_w + 0.02} 0.05"/></geometry><material name="dark"/></visual>
    <collision><origin xyz="0 0 ${chassis_z}"/><geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry></collision>
    <xacro:box_inertia m="9.0" x="${chassis_l}" y="${chassis_w}" z="${chassis_h}"><origin xyz="0 0 ${chassis_z - 0.02}"/></xacro:box_inertia>
  </link>
  <gazebo reference="base_link"><mu1>0.4</mu1><mu2>0.4</mu2></gazebo>

  <xacro:macro name="wheel" params="name x side">
    <link name="${name}_wheel">
      <visual><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry><material name="rubber"/></visual>
      <visual><origin xyz="0 ${side*(wheel_w/2 + 0.002)} 0" rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_r*0.45}" length="0.004"/></geometry><material name="metal"/></visual>
      <collision><origin rpy="${pi/2} 0 0"/><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
      <inertial><mass value="0.7"/>
        <inertia ixx="${0.7*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}" iyy="${0.7*wheel_r*wheel_r/2}"
                 izz="${0.7*(3*wheel_r*wheel_r + wheel_w*wheel_w)/12}" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="${x} ${side*track/2} 0"/><axis xyz="0 1 0"/>
      <limit effort="30" velocity="12"/>
    </joint>
    <gazebo reference="${name}_wheel"><mu1>1.5</mu1><mu2>1.5</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel name="lf" x="${axle_x}" side="1"/>
  <xacro:wheel name="lm" x="0" side="1"/>
  <xacro:wheel name="lr" x="${-axle_x}" side="1"/>
  <xacro:wheel name="rf" x="${axle_x}" side="-1"/>
  <xacro:wheel name="rm" x="0" side="-1"/>
  <xacro:wheel name="rr" x="${-axle_x}" side="-1"/>

  <!-- ===== sensors ===== -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.035" length="0.045"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0 0 0.024"/><geometry><cylinder radius="0.03" length="0.004"/></geometry><material name="body"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.045"/></geometry></collision>
    <xacro:box_inertia m="0.2" x="0.07" y="0.07" z="0.045"><origin xyz="0 0 0"/></xacro:box_inertia>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.18 0 ${chassis_z + chassis_h/2 + 0.05}"/>
  </joint>

  <link name="mast_link">
    <visual><origin xyz="0 0 ${(head_z - chassis_z - chassis_h/2)/2}"/>
      <geometry><cylinder radius="0.02" length="${head_z - chassis_z - chassis_h/2}"/></geometry><material name="metal"/></visual>
    <collision><origin xyz="0 0 ${(head_z - chassis_z - chassis_h/2)/2}"/>
      <geometry><cylinder radius="0.02" length="${head_z - chassis_z - chassis_h/2}"/></geometry></collision>
    <xacro:box_inertia m="0.3" x="0.04" y="0.04" z="0.3"><origin xyz="0 0 0.15"/></xacro:box_inertia>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/><child link="mast_link"/>
    <origin xyz="${mast_x} 0 ${chassis_z + chassis_h/2}"/>
  </joint>

  <!-- Camera head: RGB + thermal behind one window, tilted 8.6 deg down. -->
  <link name="camera_link">
    <visual><geometry><box size="0.07 0.12 0.06"/></geometry><material name="dark"/></visual>
    <visual><origin xyz="0.036 0.03 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.016" length="0.004"/></geometry><material name="eye"/></visual>
    <visual><origin xyz="0.036 -0.03 0" rpy="0 ${pi/2} 0"/><geometry><cylinder radius="0.016" length="0.004"/></geometry><material name="metal"/></visual>
    <collision><geometry><box size="0.07 0.12 0.06"/></geometry></collision>
    <xacro:box_inertia m="0.3" x="0.07" y="0.12" z="0.06"><origin xyz="0 0 0"/></xacro:box_inertia>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="${mast_x + 0.04} 0 ${head_z}" rpy="0 0.15 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
  </joint>

  <xacro:include filename="$(find rescue_description)/urdf/sensors.xacro"/>
  <xacro:if value="$(arg sensors)">
    <xacro:rescue_sensors ns="${ns}"/>
  </xacro:if>

  <!-- ===== drive ===== -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>lf_wheel_joint</left_joint>
      <left_joint>lm_wheel_joint</left_joint>
      <left_joint>lr_wheel_joint</left_joint>
      <right_joint>rf_wheel_joint</right_joint>
      <right_joint>rm_wheel_joint</right_joint>
      <right_joint>rr_wheel_joint</right_joint>
      <wheel_separation>${track}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <topic>/${ns}/cmd_vel</topic>
      <!-- its own (perfect) odometry stays inside Gazebo; the odometry node models a real one -->
      <odom_topic>/${ns}/diff_drive/odom</odom_topic>
      <tf_topic>/${ns}/diff_drive/tf</tf_topic>
      <frame_id>${ns}/dd_odom</frame_id>
      <child_frame_id>${ns}/dd_base</child_frame_id>
      <max_linear_velocity>0.9</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>1.2</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
    </plugin>
  </gazebo>
  <xacro:ground_truth_odom ns="${ns}"/>
</robot>
