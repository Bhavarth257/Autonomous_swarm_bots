<?xml version="1.0"?>
<!--
  Small differential-drive search robot (~0.30 x 0.29 m) sized to fit through rubble gaps.
  Every topic and TF frame is prefixed with the namespace `ns` so several robots can share
  one Gazebo world and one /tf tree (r1/base_link, r2/base_link, ...).

  Heights matter: the 2D lidar plane is at 0.145 m, below the top of a lying victim (0.2 m)
  and every rubble piece the world generator makes (>= 0.25 m).
-->
<robot name="rescue_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="ns" default="r1"/>
  <xacro:property name="ns" value="$(arg ns)"/>

  <xacro:property name="base_l" value="0.30"/>
  <xacro:property name="base_w" value="0.22"/>
  <xacro:property name="base_h" value="0.09"/>
  <xacro:property name="base_z" value="0.075"/>   <!-- base_link centre above the floor -->
  <xacro:property name="wheel_r" value="0.05"/>
  <xacro:property name="wheel_w" value="0.03"/>
  <xacro:property name="wheel_sep" value="0.26"/>
  <xacro:property name="caster_r" value="0.025"/>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial><mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cyl_inertia" params="m r h">
    <inertial><mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" iyy="${m*(3*r*r+h*h)/12}" izz="${m*r*r/2}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertia" params="m r">
    <inertial><mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" iyy="${2*m*r*r/5}" izz="${2*m*r*r/5}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <material name="body"><color rgba="0.95 0.45 0.05 1"/></material>
  <material name="dark"><color rgba="0.12 0.12 0.12 1"/></material>

  <!-- ===== chassis ===== -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual><geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry><material name="body"/></visual>
    <collision><geometry><box size="${base_l} ${base_w} ${base_h}"/></geometry></collision>
    <xacro:box_inertia m="2.0" x="${base_l}" y="${base_w}" z="${base_h}"/>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${base_z}"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry><material name="dark"/></visual>
      <collision><geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry></collision>
      <xacro:cyl_inertia m="0.2" r="${wheel_r}" h="${wheel_w}"/>
    </link>
    <!-- Wheel cylinder axis is its local z; rotated so it points along +y. -->
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} ${wheel_r - base_z}" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <gazebo reference="${side}_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_sep/2}"/>
  <xacro:wheel side="right" y="${-wheel_sep/2}"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster_link">
      <visual><geometry><sphere radius="${caster_r}"/></geometry><material name="dark"/></visual>
      <collision><geometry><sphere radius="${caster_r}"/></geometry></collision>
      <xacro:sphere_inertia m="0.05" r="${caster_r}"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster_link"/>
      <origin xyz="${x} 0 ${caster_r - base_z}"/>
    </joint>
    <gazebo reference="${name}_caster_link"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>
  </xacro:macro>
  <xacro:caster name="front" x="0.11"/>
  <xacro:caster name="rear" x="-0.11"/>

  <!-- ===== sensors ===== -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.035" length="0.04"/></geometry><material name="dark"/></visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <xacro:cyl_inertia m="0.1" r="0.035" h="0.04"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.0 0 0.07"/>
  </joint>

  <link name="camera_link">
    <visual><geometry><box size="0.03 0.08 0.03"/></geometry><material name="dark"/></visual>
    <xacro:box_inertia m="0.05" x="0.03" y="0.08" z="0.03"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.145 0 0.06"/>
  </joint>
  <!-- ROS optical convention: z forward, x right, y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
  </joint>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/${ns}/scan</topic>
      <ignition_frame_id>${ns}/lidar_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.12414</max_angle>
        </horizontal></scan>
        <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>/${ns}/camera/image_raw</topic>
      <ignition_frame_id>${ns}/camera_optical_frame</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>25</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/${ns}/imu</topic>
      <ignition_frame_id>${ns}/imu_link</ignition_frame_id>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- ===== actuation ===== -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>
      <max_linear_velocity>0.6</max_linear_velocity>
      <min_linear_velocity>-0.6</min_linear_velocity>
      <max_angular_velocity>2.0</max_angular_velocity>
      <min_angular_velocity>-2.0</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <topic>/${ns}/cmd_vel</topic>
      <odom_topic>/${ns}/odom</odom_topic>
      <tf_topic>/${ns}/tf</tf_topic>
      <frame_id>${ns}/odom</frame_id>
      <child_frame_id>${ns}/base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/${ns}/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
