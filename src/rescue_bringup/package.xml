<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rescue_bringup</name>
  <version>0.1.0</version>
  <description>Launch files for the collapsed-building rescue swarm simulation.</description>
  <maintainer email="bhavarthkokane25@gmail.com">bhavarth</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rescue_world</exec_depend>
  <exec_depend>rescue_description</exec_depend>
  <exec_depend>rescue_wheelleg</exec_depend>
  <exec_depend>rescue_navigation</exec_depend>
  <exec_depend>rescue_perception</exec_depend>
  <exec_depend>rescue_swarm</exec_depend>
  <exec_depend>rescue_dashboard</exec_depend>
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
