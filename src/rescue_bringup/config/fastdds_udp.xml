<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS over UDP only, no shared memory. With ~50 nodes starting together, the
     shared-memory transport sometimes left a node blocked on a port lock at startup
     (a planner or SLAM that never answered, and a robot that never moved). The launch
     files set FASTRTPS_DEFAULT_PROFILES_FILE to this file unless one is already set. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="udp_only_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
