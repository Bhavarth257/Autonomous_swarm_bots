<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rescue_swarm</name>
  <version>0.1.0</version>
  <description>Decentralized swarm: simulated range-limited radio and per-robot gossip agents sharing positions, claims, explored areas and victims.</description>
  <maintainer email="bhavarthkokane25@gmail.com">bhavarth</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rescue_navigation</exec_depend>
  <exec_depend>rescue_perception</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
